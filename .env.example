# Copy to .env and fill in. Never commit .env or paste keys into chats.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# The number on your bag, e.g. Vexo-HACK-07 -> 7. Never guess, never use 42.
BAND_NUMBER=
# ble (Bluetooth), usb (cable) or sim (pretend band, no mic)
BAND_TRANSPORT=ble
WEARER_NAME=Me
VOICE_THRESHOLD=0.75
MIN_UTTERANCE_SECONDS=1.5
